# GridScope Backend Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for LLM features)
OPENAI_API_KEY=your-api-key-here

# OpenAI Model (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Server Configuration
# Loopback-only by default: the backend is unreachable from the network.
# Only set HOST=0.0.0.0 to expose it deliberately, and pair that with
# GRIDSCOPE_API_TOKEN below.
HOST=127.0.0.1
PORT=8000

# API access token (optional). When set, every endpoint requires
# 'Authorization: Bearer <token>'. Required in practice for any non-loopback
# HOST. Give the same value to the frontend as VITE_GRIDSCOPE_API_TOKEN.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# GRIDSCOPE_API_TOKEN=

